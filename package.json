{
  "name": "mcdocs",
  "version": "1.0.0",
  "scripts": {
    "build:css": "postcss src/css/**/*.css --dir assets/css/ --config postcss.config.js",
    "build:css:min": "postcss src/css/**/*.css --dir assets/css/ --env production",
    "build:js": "terser src/js/main.js -o assets/js/main.min.js -c -m",
    "build:assets": "npm run build:css:min && npm run build:js",
    "validate:html": "html-validate site/**/*.html",
    "test:lighthouse": "lighthouse http://localhost:8000 --output html --output-path ./lighthouse-report.html",
    "optimize:images": "imagemin src/images/* --out-dir=assets/images",
    "clean": "rm -rf assets/ site/ build/",
    "dev": "npm run build:css && mkdocs serve"
  },
  "devDependencies": {
    "postcss": "^8.4.24",
    "postcss-cli": "^10.1.0",
    "postcss-preset-env": "^8.0.1",
    "autoprefixer": "^10.4.14",
    "cssnano": "^5.1.15",
    "terser": "^5.16.1",
    "clean-css-cli": "^5.6.2",
    "html-minifier-terser": "^7.0.0",
    "stylelint": "^15.0.0",
    "eslint": "^8.0.0",
    "lighthouse": "^9.0.0",
    "pa11y": "^6.0.0",
    "imagemin-cli": "^7.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}